# Copy to .env and fill in your key:  cp .env.example .env
#
# Your PERSONAL LLM key from the course portal: Profile -> API key -> Copy.
# It is a secret — .env is git-ignored; never commit it.
OPENAI_API_KEY=sk-...your-personal-key...

# The class proxy (OpenAI-compatible). Leave as-is unless told otherwise.
OPENAI_BASE_URL=https://llm.nat-d.uk/v1

# Models served by the proxy.
CHAT_MODEL=gemma-4-E4B-it
EMBED_MODEL=bge-m3
